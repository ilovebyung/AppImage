-- 🏢 Company  (4 digit phone number)
CREATE TABLE IF NOT EXISTS Company (
    company_id INTEGER PRIMARY KEY,
    description TEXT NOT NULL 
);

-- 🏢 Site  (4 digit phone number)
CREATE TABLE IF NOT EXISTS Site (
    site_id INTEGER PRIMARY KEY,
    description TEXT NOT NULL 
);

-- 🏢 Device
CREATE TABLE IF NOT EXISTS Device (
    device_id INTEGER PRIMARY KEY AUTOINCREMENT,
    description TEXT NOT NULL,
    ip_address TEXT 
);

-- 🏢 Service Area 
CREATE TABLE IF NOT EXISTS Service_Area (
    service_area_id INTEGER PRIMARY KEY, 
    description TEXT,
    status INTEGER DEFAULT 0,
    timestamp DATETIME DEFAULT (datetime('now', 'localtime'))
);


-- 🥪 Category Table
CREATE TABLE IF NOT EXISTS Category (
    category_id INTEGER PRIMARY KEY AUTOINCREMENT,
    description TEXT NOT NULL,
    status INTEGER DEFAULT 1
);

-- 🥪 Product Table
CREATE TABLE IF NOT EXISTS Product (
    product_id INTEGER PRIMARY KEY AUTOINCREMENT,
    description TEXT NOT NULL,
    category_id INTEGER,
    price INTEGER NOT NULL,
    tax REAL DEFAULT 4.712,
    status INTEGER DEFAULT 1,
    rank INTEGER DEFAULT 1,
    FOREIGN KEY (category_id) REFERENCES Category(category_id)
);

-- 🧂 Modifier Type 
CREATE TABLE IF NOT EXISTS Modifier_Type (
    modifier_type_id INTEGER PRIMARY KEY AUTOINCREMENT,
    description TEXT NOT NULL
);


-- 🧂Modifier 
CREATE TABLE IF NOT EXISTS Modifier (
    modifier_id INTEGER PRIMARY KEY AUTOINCREMENT,
    description TEXT NOT NULL,
    product_id INTEGER,
    modifier_type_id INTEGER DEFAULT 1,
    price INTEGER DEFAULT 0 CHECK (price >= 0 AND typeof(price) = 'integer'),
    status INTEGER DEFAULT 1,
    FOREIGN KEY (product_id) REFERENCES Product(product_id),
    FOREIGN KEY (modifier_type_id) REFERENCES Modifier_Type(modifier_type_id),
    FOREIGN KEY (modifier_id) REFERENCES Modifier_Item(modifier_id)
);

CREATE INDEX IF NOT EXISTS idx_modifier_product_id 
ON Modifier(product_id);

-- 🛒 Order Product Table
CREATE TABLE IF NOT EXISTS Order_Product (
    order_product_id INTEGER PRIMARY KEY AUTOINCREMENT,
    order_id INTEGER,
    product_id INTEGER,
    modifiers TEXT,
    product_quantity INTEGER NOT NULL,
    FOREIGN KEY (order_id) REFERENCES Order_Cart(order_id),
    FOREIGN KEY (product_id) REFERENCES Product(product_id)
);

CREATE INDEX IF NOT EXISTS idx_order_product_order_id 
ON Order_Product(order_id);

-- 🛒 Order_Cart Table  (‘Order’ is a reserved word)
CREATE TABLE IF NOT EXISTS Order_Cart (
    order_id INTEGER PRIMARY KEY AUTOINCREMENT,
    order_status INTEGER NOT NULL DEFAULT 0,
    service_area_id INTEGER NOT NULL,
    customer_id INTEGER,
    username TEXT,
    subtotal INTEGER DEFAULT 0,
    total INTEGER DEFAULT 0,
    tip INTEGER DEFAULT 0,
    provided_name TEXT,
    note TEXT,
    created_at DATETIME DEFAULT (datetime('now', 'localtime')),
    FOREIGN KEY (service_area_id) REFERENCES Service_Area(service_area_id),
    FOREIGN KEY (customer_id) REFERENCES Customer(customer_id)
);

-- 🛒 Order Live Cart Table
CREATE TABLE IF NOT EXISTS Live_Cart (
    session_id TEXT,
    product_name TEXT,
    modifiers_text TEXT,
    quantity INTEGER,
    unit_price INTEGER,
    total_price INTEGER,
    last_updated DATETIME DEFAULT (datetime('now', 'localtime'))
);

-- 🛒📜 Order History Table
CREATE TABLE IF NOT EXISTS  Order_History (
    order_id INTEGER,
    order_status INTEGER,
    username TEXT,
    subtotal INTEGER,
    total INTEGER,
    timestamp DATETIME DEFAULT (datetime('now', 'localtime')),
    FOREIGN KEY (order_id) REFERENCES Order_Cart(order_id)
); 

CREATE TRIGGER IF NOT EXISTS log_order_insert
AFTER INSERT ON Order_Cart
FOR EACH ROW
BEGIN
    INSERT INTO Order_History (order_id, order_status, username, subtotal, total, timestamp)
    VALUES (NEW.order_id, NEW.order_status, NEW.username, NEW.subtotal, NEW.total, CURRENT_TIMESTAMP);
END;

CREATE TRIGGER IF NOT EXISTS log_order_update
AFTER UPDATE ON Order_Cart
FOR EACH ROW
BEGIN
    INSERT INTO Order_History (order_id, order_status, username, subtotal, total, timestamp)
    VALUES (NEW.order_id, NEW.order_status, NEW.username, NEW.subtotal, NEW.total, CURRENT_TIMESTAMP);
END;

CREATE INDEX IF NOT EXISTS idx_order_history_order_id 
ON Order_History(order_id);

CREATE INDEX IF NOT EXISTS idx_order_history_timestamp
ON Order_History(timestamp);


-- 👤 Customer Table
CREATE TABLE IF NOT EXISTS Customer (
    customer_id INTEGER PRIMARY KEY, -- phone number as unique int
    description TEXT, -- name, initial or anything a customer wishes to be 
    point INTEGER DEFAULT 0
);

-- 👤📜 Customer History Table
CREATE TABLE IF NOT EXISTS  Customer_History (
    customer_id INTEGER,
    point INTEGER,
    timestamp DATETIME DEFAULT (datetime('now', 'localtime')),
    FOREIGN KEY (customer_id) REFERENCES Customer(customer_id)
); 

CREATE TRIGGER IF NOT EXISTS log_customer_insert
AFTER INSERT ON Customer
FOR EACH ROW
BEGIN
    INSERT INTO Customer_History (customer_id, point, timestamp)
    VALUES (NEW.customer_id, NEW.point, CURRENT_TIMESTAMP);
END;

CREATE TRIGGER IF NOT EXISTS log_customer_update
AFTER UPDATE ON Customer
FOR EACH ROW
BEGIN
    INSERT INTO Customer_History (customer_id, point, timestamp)
    VALUES (NEW.customer_id, NEW.point, CURRENT_TIMESTAMP);
END;



