#!/bin/bash 
HERE="$(dirname "$(readlink -f "${0}")")" 

# Use the actual version found in your build (e.g., 3.12) 
export PY_VERSION="3.12"  

# Point to the site-packages inside your venv 
export PYTHONPATH="App.AppDir/usr/venv/lib/python3.12/site-packages"

# IMPORTANT: Unset PYTHONHOME if you are relying on the system's  
# standard library but your own venv packages. 
# OR, if you want it fully portable, you must bundle the lib folder. 
unset PYTHONHOME  

# Run using the bundled python if it exists, otherwise system python 
source App.AppDir/usr/venv/bin/activate
"$HERE/usr/venv/bin/python3" -m streamlit run "$HERE/usr/app/Home.py" --server.headless true --server.port 8888

export PYTHONHOME="$HERE/usr" 
